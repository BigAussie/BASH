  headerBottom := Max(logo.GetTop() + logo.getHeight(), sourcePanel.GetTop() + sourcePanel.getHeight());
  listTop := headerBottom + TControl.AdjustToDPI(12);
  footerTop := panel.getHeight() - TControl.AdjustToDPI(120);
  colGap := TControl.AdjustToDPI(24);

  licensePanel.Create(panel);
  licensePanel.setName('license_panel');
  licensePanel.setCaption('');
  licensePanel.setBevelWidth(0);
  licensePanel.setColor($1A1814);
  licensePanel.SetLeft(TControl.AdjustToDPI(16));
  licensePanel.setWidth(TControl.AdjustToDPI(280));
  licensePanel.setHeight(TControl.AdjustToDPI(72));
  licensePanel.SetTop(panel.getHeight() - TControl.AdjustToDPI(16) - licensePanel.getHeight());

  licenseEdit.Create(licensePanel);
  licenseEdit.SetCaption('License key');
  licenseEdit.Caption.SetFontColor($A89F90);
  licenseEdit.SetTop(0);
  licenseEdit.SetLeft(0);
  licenseEdit.SetHeight(TControl.AdjustToDPI(42));
  licenseEdit.SetWidth(TControl.AdjustToDPI(280));
  licenseEdit.SetName('license_key');
  licenseEdit.SetControlColor($24201C);
  licenseEdit.setControlFontColor($F2EDE4);
  licenseEdit.SetPasswordChar('*');
  licenseEdit.SetText(BashLicenseClient.GetKey());

  saveBtn.Create(licensePanel);
  saveBtn.setName('license_save_button');
  saveBtn.SetCaption('Save');
  saveBtn.SetOnClick(@Self._SaveLicenseKey);
  saveBtn.setWidth(TControl.AdjustToDPI(64));
  saveBtn.setHeight(TControl.AdjustToDPI(24));
  saveBtn.SetTop(licenseEdit.GetBottom() + TControl.AdjustToDPI(2));
  saveBtn.SetLeft(0);

  clearBtn.Create(licensePanel);
  clearBtn.setName('license_clear_button');
  clearBtn.SetCaption('Clear');
  clearBtn.SetOnClick(@Self._ClearLicenseKey);
  clearBtn.setWidth(TControl.AdjustToDPI(64));
  clearBtn.setHeight(TControl.AdjustToDPI(24));
  clearBtn.SetTop(saveBtn.GetTop());
  clearBtn.SetLeft(saveBtn.GetLeft() + saveBtn.getWidth() + TControl.AdjustToDPI(6));

  activityCaption.Create(panel);
  activityCaption.setName('activity_filter_caption');
  activityCaption.setCaption('Filter by Activity');
  activityCaption.SetFontColor($A89F90);
  activityCaption.SetFontSize(9);
  activityCaption.SetLeft(TControl.AdjustToDPI(16));
  activityCaption.SetTop(listTop);

  categoryPanel.Create(panel);
  categoryPanel.setName('activity_category_panel');
  categoryPanel.setCaption('');
  categoryPanel.setBevelWidth(0);
  categoryPanel.setColor($1A1814);
  categoryPanel.SetLeft(TControl.AdjustToDPI(16));
  categoryPanel.SetTop(activityCaption.GetTop() + activityCaption.GetTrueHeight() + TControl.AdjustToDPI(4));
  categoryPanel.setWidth(TControl.AdjustToDPI(280));
  categoryPanel.setHeight(TControl.AdjustToDPI(24));

  catIds := String(BASH_CATEGORY_IDS).Split(',');
  catLabels := String(BASH_CATEGORY_LABELS).Split(',');
  ax := 0;
  gap := TControl.AdjustToDPI(2);
  for ai := 0 to High(catIds) do
  begin
    if catIds[ai] = 'all' then
      catW := TControl.AdjustToDPI(20)
    else if catIds[ai] = 'combat' then
      catW := TControl.AdjustToDPI(50)
    else if catIds[ai] = 'gathering' then
      catW := TControl.AdjustToDPI(58)
    else if catIds[ai] = 'production' then
      catW := TControl.AdjustToDPI(66)
    else if catIds[ai] = 'utility' then
      catW := TControl.AdjustToDPI(36)
    else
      catW := TControl.AdjustToDPI(36);

    categoryBtn.Create(categoryPanel);
    categoryBtn.setName('activity_cat_' + catIds[ai]);
    if ai <= High(catLabels) then
      categoryBtn.SetCaption(catLabels[ai])
    else
      categoryBtn.SetCaption(catIds[ai]);
    categoryBtn.SetLeft(ax);
    categoryBtn.SetTop(0);
    categoryBtn.setWidth(catW);
    categoryBtn.setHeight(TControl.AdjustToDPI(22));
    categoryBtn.setColor($24201C);
    categoryBtn.SetFontColor($F2EDE4);
    categoryBtn.SetFontSize(7);
    categoryBtn.SetOnClick(@Self._OnCategoryClick);
    ax += catW + gap;
  end;

  activityPanel.Create(panel);
  activityPanel.setName('activity_filter_panel');
  activityPanel.setCaption('');
  activityPanel.setBevelWidth(0);
  activityPanel.setColor($1A1814);
  activityPanel.SetLeft(TControl.AdjustToDPI(16));
  activityPanel.SetTop(categoryPanel.GetTop() + categoryPanel.getHeight() + TControl.AdjustToDPI(4));
  activityPanel.setWidth(TControl.AdjustToDPI(280));
  activityPanel.setHeight(TControl.AdjustToDPI(31));
  activityPanel.setVisible(False);

  actIds := String(BASH_ACTIVITY_IDS).Split(',');
  iconSize := TControl.AdjustToDPI(25);
  iconPad := TControl.AdjustToDPI(3);
  aw := iconSize + (iconPad * 2);
  ah := iconSize + (iconPad * 2);
  for ai := 0 to High(actIds) do
  begin
    activityCell.Create(activityPanel);
    activityCell.setName('activity_btn_' + actIds[ai]);
    activityCell.setCaption('');
    activityCell.setBevelWidth(0);
    activityCell.SetLeft(0);
    activityCell.SetTop(0);
    activityCell.setWidth(aw);
    activityCell.setHeight(ah);
    activityCell.setColor($24201C);
    activityCell.setHint(ActivityLabelForId(actIds[ai]));
    activityCell.setShowHint(True);
    activityCell.setOnClick(@Self._OnActivityFilterClick);
    activityCell.setVisible(False);

    iconPath := ActivityIconPath(actIds[ai]);
    if FileExists(iconPath) then
    begin
      activityIcon.Create(activityCell);
      activityIcon.setName('activity_icon_' + actIds[ai]);
      activityIcon.SetLeft(iconPad);
      activityIcon.SetTop(iconPad);
      activityIcon.setWidth(iconSize);
      activityIcon.setHeight(iconSize);
      activityIcon.SetStretch(True);
      activityIcon.SetProportional(True);
      activityIcon.setHint(ActivityLabelForId(actIds[ai]));
      activityIcon.setShowHint(True);
      activityIcon.setOnClick(@Self._OnActivityFilterClick);
      try
        activityIcon.getPicture().LoadFromFile(iconPath);
      except
      end;
    end;
  end;

  Self.RefreshCategoryChips();
  Self.RefreshActivityIconLayout();

  scriptsList.Create(panel);
  scriptsList.SetName('scripts');
  scriptsList.Panel.setName('script_list_panel');
  scriptsList.SetCaption('Scripts');
  scriptsList.Caption.SetFontColor($A89F90);
  scriptsList.SetLeft(TControl.AdjustToDPI(16));
  scriptsList.SetTop(categoryPanel.GetTop() + categoryPanel.getHeight() + TControl.AdjustToDPI(6));
  scriptsList.SetWidth(TControl.AdjustToDPI(280));
  scriptsList.setHeight(Max(TControl.AdjustToDPI(120), licensePanel.GetTop() - scriptsList.GetTop() - TControl.AdjustToDPI(6)));
  scriptsList.ListBox.ListBox.setOnClick(@Self._OnScriptChange);
  scriptsList.ListBox.ListBox.setOnKeyPress(@Self._OnScriptOnKeyDown);
  scriptsList.ListBox.ListBox.setStyle(TListBoxStyle.lbOwnerDrawFixed);
  scriptsList.ListBox.ListBox.setOnDrawItem(@Self.OnDrawItem);
  scriptsList.ListBox.ListBox.setColor($1A1814);

  Self.RelayoutScriptList();

  Self.SetupVersionsPanel(panel, TControl.AdjustToDPI(12));

  Self.SetupScriptPanel(
    panel,
    [
      scriptsList.GetRight() + colGap,
      categoryPanel.GetTop() + categoryPanel.getHeight() + TControl.AdjustToDPI(4) - TControl.AdjustToDPI(20)
    ]
  );

  if BashScriptClient.IsLocalSource() then
  begin
    Self._SetDescriptionVisible(False);
    Self._SetDiscordCtaVisible(False);
  end;

  button.Create(panel);
  button.setName('script_open_button');
  button.SetCaption('Open script');
  button.SetOnClick(@Self._OpenScriptEx);
  button.setWidth(TControl.AdjustToDPI(150));
  button.setHeight(TControl.AdjustToDPI(25));
  button.SetTop(footerTop + TControl.AdjustToDPI(45));
  button.SetLeft(panel.getWidth() - TControl.AdjustToDPI(16) - button.getWidth());

  button.Create(panel);
  button.setName('changelog_button');
  button.SetCaption('Changelog');
  button.SetOnClick(@Self._ShowChangelog);
  button.setWidth(TControl.AdjustToDPI(100));
  button.setHeight(TControl.AdjustToDPI(25));
  button.SetTop(footerTop + TControl.AdjustToDPI(45));
  button.SetLeft(
    panel.getWidth() - TControl.AdjustToDPI(16) - TControl.AdjustToDPI(150) -
    TControl.AdjustToDPI(8) - button.getWidth()
  );
  button.setHint('View changelog for the selected script');
  button.setShowHint(True);

  button.Create(panel);
  button.setName('install_rl_button');
  button.SetCaption('Install RuneLite Profile');
  button.setOnClick(@Self._InstallProfile);
  button.setWidth(TControl.AdjustToDPI(150));
  button.setHeight(TControl.AdjustToDPI(25));
  button.SetTop(footerTop + TControl.AdjustToDPI(75));
  button.SetLeft(panel.getWidth() - TControl.AdjustToDPI(16) - button.getWidth());

  Self.SetupColorLegend(panel);

  launcherRev.Create(panel);
  launcherRev.setName('launcher_revision_label');
  launcherRev.setCaption('Launcher revision: ' + ToStr(WaspUpdater.Launcher.Revision));
  launcherRev.SetFontSize(9);
  launcherRev.SetFontColor($A89F90);
  launcherRev.SetTop(footerTop + TControl.AdjustToDPI(105));
  launcherRev.setLeft(Self.Size.X div 2 - launcherRev.GetTrueWidth() div 2);
end;

procedure TWaspForm.SetupMainPanel(form: TForm);
var
  panel: TPanel;
begin
  panel.Create(form);
  panel.setName('main_panel');
  panel.setCaption('');
  panel.setWidth(Self.Size.X);
  panel.setHeight(Self.Size.Y);
  panel.setBevelWidth(0);
  panel.setColor($1A1814);
  Self.SetupScriptsPanel(panel);
end;

procedure TWaspForm.OnShow(sender: TObject);
var
  text: TLabel;
begin
  if BashLicenseClient.HasKey() then
    BashLicenseClient.FetchEntitlements(True);

  Self.PopulateScripts();

  text := Self.Form.GetChild('source_bash_label');
  if text <> nil then
    text.SetFontColor($FFFFFF);
  text := Self.Form.GetChild('source_local_label');
  if text <> nil then
    text.SetFontColor($FFFFFF);
end;

procedure TWaspForm.Setup();
begin
  Self.Size := [TControl.AdjustToDPI(920), TControl.AdjustToDPI(670)];

  Self.Form.Init(nil);
  Self.Form.SetName('bash_form');
  Self.Form.setCaption('B.A.S.H - BigAussie Script House');
  Self.Form.setWidth(Self.Size.X);
  Self.Form.setHeight(Self.Size.Y);
  Self.Form.getConstraints().SetInterfaceConstraints(Self.Size.X, Self.Size.Y, Self.Size.X, Self.Size.Y);
  Self.Form.setPosition(TPosition.poScreenCenter);
  Self.Form.setColor($1A1814);
  Self.Form.setOnShow(@Self.OnShow);

  with Self.Form.getFont() do
  begin
    setQuality(TFontQuality.fqAntialiased);
    setPitch(TFontPitch.fpFixed);
    SetColor($F2EDE4);
  end;

  Self.SetupMainPanel(Self.Form);
end;

procedure TWaspForm.Show();
begin
  try
    Self.Form.ShowModal();
  except
    Writeln(GetExceptionMessage());
  finally
    Self.Form.Free();
  end;
end;

procedure TWaspForm.Run();
begin
  Self.Setup();
  Sync(@Self.Show);
end;

function BashLauncherPath(): String;
begin
  Result := ScriptPath + BASH_LAUNCHER_FILE;
end;

function BashDefaultSimbaBody(): String;
begin
  Result :=
    '(* Thank you for choosing B.A.S.H - BigAussie Script House *)' + LineEnding +
    '(* Discord: https://discord.gg/qsmKs5uKfR *)' + LineEnding +
    LineEnding +
    '(* To start simply double click the green play button. *)' + LineEnding +
    LineEnding +
    'begin' + LineEnding +
    '  SimbaRunInTab(ScriptPath + ''bash-launcher.simba'');' + LineEnding +
    'end.' + LineEnding;
end;

function PatchDefaultSimbaToBashLauncher(): Boolean;
var
  path, content: String;
begin
  Result := False;
  if not FileExists(BashLauncherPath()) then
    Exit;

  path := AppPath + 'Data' + DirectorySeparator + 'default.simba';
  try
    if FileExists(path) then
      content := ReadFileContents(path)
    else
      content := '';
  except
    content := '';
  end;

  if content.Contains('bash-launcher.simba') and (not content.Contains('wasp-launcher.simba')) then
    Exit(True);

  try
    if WriteFileContents(path, BashDefaultSimbaBody(), False) then
    begin
      WriteLn('[B.A.S.H] Replaced Data\default.simba to open bash-launcher.simba');
      Exit(True);
    end;
  except
  end;
end;

procedure MigrateBashLauncherPaths();
begin
  PatchDefaultSimbaToBashLauncher();
end;

function ReadScriptHeaderField(path, afterToken, beforeToken: String): String;
var
  content: String;
begin
  Result := '';
  if not FileExists(path) then
    Exit;
  try
    content := ReadFileContents(path);
  except
    Exit;
  end;
  if Length(content) > 8192 then
    content := Copy(content, 1, 8192);
  Result := content.After(afterToken).Before(beforeToken);
end;

function ReadScriptIdFromFile(path: String): String;
begin
  Result := ReadScriptHeaderField(path, 'SCRIPT_ID := ''', '''}');
  if Result = '' then
    Result := ReadScriptHeaderField(path, 'SCRIPT_ID := "', '"}');
end;

function ReadScriptRevisionFromFile(path: String): Int32;
var
  revStr: String;
begin
  revStr := ReadScriptHeaderField(path, 'SCRIPT_REVISION := ''', '''}');
  if revStr = '' then
    revStr := ReadScriptHeaderField(path, 'SCRIPT_REVISION := "', '"}');
  Result := StrToIntDef(revStr, 0);
end;

function ParseScriptRevisionFromText(content: String): Int32;
var
  header, revStr: String;
begin
  Result := 0;
  if content = '' then
    Exit;
  header := content;
  if Length(header) > 8192 then
    header := Copy(header, 1, 8192);
  revStr := header.After('SCRIPT_REVISION := ''').Before('''}');
  if revStr = '' then
    revStr := header.After('SCRIPT_REVISION := "').Before('"}');
  Result := StrToIntDef(revStr, 0);
end;

function IsBashLauncherFile(path: String): Boolean;
begin
  Result := SameText(ReadScriptIdFromFile(path), {$MACRO SCRIPT_ID});
end;

function WriteBashLauncherFile(dest, body: String): Boolean;
var
  tmp, bak, dir: String;
begin
  Result := False;
  if Length(body) < 500 then
    Exit;

  dir := ExtractFilePath(dest);
  if (dir <> '') and (not DirectoryExists(dir)) then
  begin
    if not ForceDirectories(dir) then
      Exit;
  end;

  try
    if WriteFileContents(dest, body, False) then
      Exit(True);
  except
  end;

  tmp := dest + '.tmp';
  bak := dest + '.bak';
  try
    if FileExists(tmp) then
      DeleteFile(tmp);
    if not WriteFileContents(tmp, body, False) then
      Exit;

    try
      if FileExists(dest) then
        WriteFileContents(bak, ReadFileContents(dest), False);
    except
    end;

    if FileExists(dest) and (not DeleteFile(dest)) then
    begin
      if FileExists(dest + '.new') then
        DeleteFile(dest + '.new');
      if not RenameFile(tmp, dest + '.new') then
        DeleteFile(tmp);
      Exit;
    end;

    if RenameFile(tmp, dest) then
      Exit(True);

    Result := WriteFileContents(dest, body, False);
    if FileExists(tmp) then
      DeleteFile(tmp);
  except
    if FileExists(tmp) then
      DeleteFile(tmp);
  end;
end;

function DownloadBashLauncherBody(): String;
var
  http, code: Int32;
  url: String;
begin
  Result := '';
  http := InitializeHTTPClient(True);
  try
    SetHTTPHeader(http, 'User-Agent', 'B.A.S.H-Launcher');
    SetHTTPHeader(http, 'Accept', '*/*');
    try
      SetSocketTimeout(http, 60000);
    except
    end;

    url := BASH_LAUNCHER_GITHUB_RAW + '?t=' + ToStr(GetTickCount());
    Result := GetHTTPPage(http, url);
    code := GetHTTPResponseCode(http);
    if (code = 200) and (Length(Result) >= 500) then
      Exit;

    Result := GetHTTPPage(http, BASH_PREMIUM_API + '/v1/launcher/download');
    code := GetHTTPResponseCode(http);
    if (code <> 200) or (Length(Result) < 500) then
      Result := '';
  except
    Result := '';
  finally
    FreeHTTPClient(http);
  end;
end;

function DownloadBashLauncherToFile(dest: String): Boolean;
var
  http, code: Int32;
  tmp, dir: String;
begin
  Result := False;
  dir := ExtractFilePath(dest);
  if (dir <> '') and (not DirectoryExists(dir)) then
  begin
    if not ForceDirectories(dir) then
      Exit;
  end;

  tmp := dest + '.download';
  if FileExists(tmp) then
    DeleteFile(tmp);

  http := InitializeHTTPClient(True);
  try
    SetHTTPHeader(http, 'User-Agent', 'B.A.S.H-Launcher');
    SetHTTPHeader(http, 'Accept', '*/*');
    try
      SetSocketTimeout(http, 60000);
    except
    end;

    WriteLn('[B.A.S.H] Downloading launcher from GitHub...');
    code := GetHTTPPageEx(http, BASH_LAUNCHER_GITHUB_RAW + '?t=' + ToStr(GetTickCount()), tmp);
    if (code <> 200) or (not FileExists(tmp)) then
    begin
      WriteLn('[B.A.S.H] GitHub download failed (HTTP ', code, ').');
      if FileExists(tmp) then
        DeleteFile(tmp);
      Exit;
    end;

    try
      if Length(ReadFileContents(tmp)) < 500 then
      begin
        WriteLn('[B.A.S.H] GitHub download was empty/too small.');
        DeleteFile(tmp);
        Exit;
      end;
    except
      DeleteFile(tmp);
      Exit;
    end;

    if FileExists(dest) and (not DeleteFile(dest)) then
    begin
      if FileExists(dest + '.new') then
        DeleteFile(dest + '.new');
      if RenameFile(tmp, dest + '.new') then
        WriteLn('[B.A.S.H] Destination locked; saved as ', dest, '.new')
      else
        DeleteFile(tmp);
      Exit;
    end;

    if RenameFile(tmp, dest) then
      Exit(True);

    try
      Result := CopyFile(tmp, dest, True);
    except
      Result := False;
    end;
    if FileExists(tmp) then
      DeleteFile(tmp);
  except
    WriteLn('[B.A.S.H] DownloadBashLauncherToFile error: ', GetExceptionMessage());
    if FileExists(tmp) then
      DeleteFile(tmp);
  finally
    FreeHTTPClient(http);
  end;
end;

procedure FinishBashLauncherRestart();
begin
  WriteLn('[B.A.S.H] Launcher ready at bash-launcher.simba — press New / play to open it');
  try
    SimbaCloseCurrentTab();
  except
  end;
  TerminateScript();
end;

function InstallBashLauncherToDefaultPath(): Boolean;
var
  dest, body: String;
  selfRev, installedRev, bodyRev: Int32;

  function LooksLikeLauncherBody(const content: String): Boolean;
  begin
    Result :=
      (Length(content) >= 500) and
      (content.Contains({$MACRO SCRIPT_ID}) or content.Contains('BASH_LAUNCHER') or
       content.Contains('B.A.S.H'));
  end;

begin
  Result := False;
  dest := BashLauncherPath();
  selfRev := StrToIntDef({$MACRO SCRIPT_REVISION}, 1);
  installedRev := ReadScriptRevisionFromFile(dest);

  body := '';
  if FileExists(ScriptFile) then
  begin
    try
      body := ReadFileContents(ScriptFile);
    except
      body := '';
    end;
  end;

  if LooksLikeLauncherBody(body) then
  begin
    if WriteBashLauncherFile(dest, body) then
    begin
      WriteLn('[B.A.S.H] Installed launcher to ', dest, ' from running file (rev ', selfRev, ')');
      Exit(True);
    end;
    WriteLn('[B.A.S.H] Could not write running launcher copy to ', dest);
  end
  else
    WriteLn('[B.A.S.H] Running file is not a readable launcher source: ', ScriptFile);

  body := DownloadBashLauncherBody();
  bodyRev := ParseScriptRevisionFromText(body);

  if (Length(body) >= 500) and (bodyRev > installedRev) then
  begin
    if WriteBashLauncherFile(dest, body) then
    begin
      WriteLn('[B.A.S.H] Installed launcher to ', dest, ' from remote (rev ', bodyRev, ')');
      Exit(True);
    end;
  end
  else if (bodyRev > 0) and (bodyRev <= installedRev) then
    WriteLn('[B.A.S.H] Skipping remote install (remote rev ', bodyRev, ' <= installed ', installedRev, ')')
  else if (bodyRev > 0) and (bodyRev < selfRev) and (bodyRev <= installedRev) then
    WriteLn('[B.A.S.H] Skipping remote install (remote rev ', bodyRev, ' < local ', selfRev, ')');
end;

procedure EnsureBashLauncherOnDefaultPath();
var
  dest, body: String;
  selfRev, installedRev: Int32;
  legacyWasp, needsInstall, looksLikeLegacyWasp: Boolean;
begin
  dest := BashLauncherPath();
  selfRev := StrToIntDef({$MACRO SCRIPT_REVISION}, 1);
  legacyWasp := SameText(ExtractFileName(ScriptFile), 'wasp-launcher.simba');

  installedRev := ReadScriptRevisionFromFile(dest);
  looksLikeLegacyWasp := False;
  if FileExists(dest) and IsBashLauncherFile(dest) then
  begin
    try
      body := ReadFileContents(dest);
      looksLikeLegacyWasp :=
        body.Contains('BASH_LAUNCHER_FILE') and
        (body.Contains('BASH_LAUNCHER_FILE  = ''wasp-launcher.simba''') or
         body.Contains('BASH_LAUNCHER_FILE = ''wasp-launcher.simba'''));
    except
    end;
  end;

  needsInstall :=
    legacyWasp or
    (not FileExists(dest)) or
    (not IsBashLauncherFile(dest)) or
    (installedRev < selfRev) or
    looksLikeLegacyWasp;

  if needsInstall then
  begin
    WriteLn(
      '[B.A.S.H] Migrating launcher to ', dest,
      ' (installed rev ', Max(installedRev, 0),
      ', local rev ', selfRev,
      ', from ', ExtractFileName(ScriptFile), ')'
    );
    if not InstallBashLauncherToDefaultPath() then
    begin
      WriteLn('[B.A.S.H] Launcher install failed for: ', dest);
      if FileExists(dest + '.new') then
        MessageDlg(
          'B.A.S.H',
          'Could not replace the open launcher file.' + LineEnding + LineEnding +
            'Close every tab for bash-launcher.simba, then either:' + LineEnding +
            '1) Run this script again, or' + LineEnding +
            '2) Rename:' + LineEnding + dest + '.new' + LineEnding +
            '   to bash-launcher.simba',
          TMsgDlgType.mtWarning,
          []
        )
      else if installedRev < selfRev then
        MessageDlg(
          'B.A.S.H',
          'Could not copy this newer launcher into:' + LineEnding + dest + LineEnding + LineEnding +
            'Close any open bash-launcher.simba tabs and run again.' + LineEnding +
            'If that fails, copy your launcher file over bash-launcher.simba manually.',
          TMsgDlgType.mtWarning,
          []
        )
      else
        MessageDlg(
          'B.A.S.H',
          'Could not install launcher to:' + LineEnding + dest + LineEnding + LineEnding +
            'Check your internet connection and that GitHub is reachable.',
          TMsgDlgType.mtWarning,
          []
        );
      if not FileExists(dest) then
        Exit;
    end;
  end;

  MigrateBashLauncherPaths();

  if legacyWasp then
    FinishBashLauncherRestart();
end;

procedure CheckBashLauncherUpdate();
var
  http, code, remoteRev, runningRev, installedRev, apiRev, githubRev: Int32;
  response, body, githubBody, dest, source, githubUrl: String;
  json: TJSONObject;
begin
  {$IFDEF DEVELOPER_MODE}
  EnsureBashLauncherOnDefaultPath();
  Exit;
  {$ENDIF}

  runningRev := StrToIntDef({$MACRO SCRIPT_REVISION}, 1);
  dest := BashLauncherPath();
  installedRev := 0;
  if FileExists(dest) and IsBashLauncherFile(dest) then
    installedRev := ReadScriptRevisionFromFile(dest);

  apiRev := 0;
  githubRev := 0;
  githubBody := '';
  body := '';
  source := '';

  http := InitializeHTTPClient(True);
  try
    SetHTTPHeader(http, 'User-Agent', 'B.A.S.H-Launcher');
    try
      SetSocketTimeout(http, 60000);
    except
    end;

    SetHTTPHeader(http, 'Accept', 'application/json');
    try
      response := GetHTTPPage(http, BASH_PREMIUM_API + '/v1/launcher');
      code := GetHTTPResponseCode(http);
      if code = 200 then
      begin
        try
          json.Init(response);
          try
            apiRev := json.optInt('revision', 0);
          finally
            json.Free();
          end;
        except
          apiRev := 0;
        end;
      end;
    except
      apiRev := 0;
    end;

    SetHTTPHeader(http, 'Accept', '*/*');
    try
      githubUrl := BASH_LAUNCHER_GITHUB_RAW + '?t=' + ToStr(GetTickCount());
      githubBody := GetHTTPPage(http, githubUrl);
      code := GetHTTPResponseCode(http);
      if (code = 200) and (Length(githubBody) >= 500) then
        githubRev := ParseScriptRevisionFromText(githubBody)
      else
        githubBody := '';
    except
      githubBody := '';
      githubRev := 0;
    end;

    remoteRev := Max(apiRev, githubRev);
    WriteLn(
      '[B.A.S.H] Launcher revs - running ', runningRev,
      ', installed ', installedRev,
      ', API ', apiRev,
      ', GitHub ', githubRev
    );

    if remoteRev <= installedRev then
    begin
      EnsureBashLauncherOnDefaultPath();
      Exit;
    end;

    if githubRev >= apiRev then
    begin
      body := githubBody;
      source := 'GitHub';
      remoteRev := githubRev;
    end
    else
    begin
      body := GetHTTPPage(http, BASH_PREMIUM_API + '/v1/launcher/download');
      code := GetHTTPResponseCode(http);
      if (code = 200) and (Length(body) >= 500) then
      begin
        source := 'API';
        remoteRev := apiRev;
        if ParseScriptRevisionFromText(body) > 0 then
          remoteRev := Max(remoteRev, ParseScriptRevisionFromText(body));
      end
      else if githubBody <> '' then
      begin
        body := githubBody;
        source := 'GitHub (API download failed)';
        remoteRev := githubRev;
      end
      else
      begin
        WriteLn('[B.A.S.H] Launcher download failed from API and GitHub.');
        EnsureBashLauncherOnDefaultPath();
        Exit;
      end;
    end;

    if Length(body) < 500 then
    begin
      WriteLn('[B.A.S.H] Launcher download was empty. Falling back to local install...');
      EnsureBashLauncherOnDefaultPath();
      Exit;
    end;

    WriteLn('[B.A.S.H] Remote launcher update installed ', installedRev, ' -> ', remoteRev, ' from ', source);
    if not WriteBashLauncherFile(dest, body) then
    begin
      WriteLn('[B.A.S.H] Remote write failed. Falling back to local install...');
      EnsureBashLauncherOnDefaultPath();
      Exit;
    end;

    WriteLn('[B.A.S.H] Launcher installed to ', dest);
    MigrateBashLauncherPaths();
    FinishBashLauncherRestart();
  except
    WriteLn('[B.A.S.H] Launcher update failed: ', GetExceptionMessage());
    EnsureBashLauncherOnDefaultPath();
  finally
    FreeHTTPClient(http);
  end;
end;

var
  WaspForm: TWaspForm;

{$ENDIF}
{$ENDIF}
{$ENDIF}
{$ENDIF}
{$ENDIF}
{$ENDIF}
{$ENDIF}
{$ENDIF}
{$ENDIF}
{$ENDIF}
{$ENDIF}

begin
  ClearDebug();
  WaspAsync.Setup();
  LauncherConfig.Setup(AppPath + 'Configs' + DirectorySeparator + 'bash-launcher.json');
  BashScriptClient.Setup();
  BashLicenseClient.Setup();
  WaspUpdater.Setup();
  GitHubClient.Setup();
  CheckBashLauncherUpdate();
  EnsureBashUiAssets();
  WaspForm.Run();
end.
