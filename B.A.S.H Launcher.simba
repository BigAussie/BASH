  memoInnerPanel.setHeight(memoOutterPanel.getHeight() - TControl.AdjustToDPI(2));
  memoInnerPanel.setBevelWidth(0);
  memoInnerPanel.setColor($24201C);

  memo.Create(memoInnerPanel);
  memo.setName('script_content_memo');
  memo.setLeft(-TControl.AdjustToDPI(1));
  memo.SetTop(-TControl.AdjustToDPI(1));
  memo.setWidth(memoInnerPanel.getWidth() + TControl.AdjustToDPI(2));
  memo.setHeight(memoInnerPanel.getHeight() + TControl.AdjustToDPI(2));
  memo.setColor($24201C);
  memo.SetFontColor($F2EDE4);
  memo.setScrollBars(TScrollStyle.ssAutoBoth);
  memo.setReadOnly(True);
  memo.setHideSelection(True);
  memo.setWordWrap(True);
end;

procedure TWaspForm.OnDrawItem(control: TWinControl; idx: Integer; rect: TRect; state: TOwnerDrawState);
var
  listbox: TListBox;
  color, fColor: TColor;
  text: String;
  textH, textY: Int32;
begin
  listbox := control;
  if listbox.getItems().getCount() = 0 then Exit;
  if idx = listbox.getItemIndex() then color := $3A342C
  else if idx mod 2 = 0 then color := $24201C
  else color := $1A1814;

  fColor := $F2EDE4;
  if (idx >= 0) and (idx <= High(Self.VisibleScripts)) then
  begin
    case Self.VisibleScripts[idx].Typ of
      EScriptType.PREMIUM,
      EScriptType.TESTING,
      EScriptType.FULL: fColor := $3DCF7A;
      EScriptType.PREMIUM_NO_SUB: fColor := $3084B8;
      EScriptType.TESTING_NO_SUB: fColor := $C8904A;
      EScriptType.FULL_NO_SUB: fColor := $4C5DE8;
    end;
  end;

  listbox.getCanvas().getBrush().setColor(color);
  listbox.getCanvas().FillRect(rect.Left, rect.Top, rect.Right, rect.Bottom);

  listbox.getCanvas().GetFont().setColor(fColor);
  listbox.getCanvas().getFont().setStyle([TFontStyle.fsBold]);
  text := listbox.getItems().getStrings(idx);
  textH := listbox.getCanvas().TextHeight(text);
  textY := rect.Top + ((rect.Bottom - rect.Top) - textH) div 2;
  if textY < rect.Top then
    textY := rect.Top;
  listbox.getCanvas().TextRect(rect, TControl.AdjustToDPI(6), textY, text);
end;

procedure TWaspForm.SetupScriptsPanel(parent: TPanel);
  type TWaspForm = TWaspForm;

  procedure TWaspForm._OnBrandingClick(sender: TObject);
  begin
    OpenBashDiscord(sender);
  end;

var
  panel, accentBar, sourcePanel, licensePanel, activityPanel, activityCell, categoryPanel: TPanel;
  logo, activityIcon: TImage;
  branding, subtitle, discordLink, launcherRev, bashLabel, localLabel, activityCaption: TLabel;
  button, saveBtn, clearBtn, categoryBtn: TButton;
  scriptsList: TLabeledDarkListBox;
  licenseEdit: TLabeledEdit;
  bashRadio, localRadio: TRadioButton;
  listTop, footerTop, colGap, logoSize, textLeft, headerBottom, radioTop: Int32;
  logoPath, iconPath: String;
  actIds, catIds, catLabels: TStringArray;
  ai, ax, aw, ah, gap, iconSize, iconPad, catW: Int32;
begin
  panel.Create(parent);
  panel.setName('scripts_panel');
  panel.setCaption('');
  panel.setWidth(Self.Size.X);
  panel.setHeight(Self.Size.Y);
  panel.setBevelWidth(0);
  panel.setColor($1A1814);

  Self.ActivityFilter := 'all';
  Self.ActivityCategory := 'all';
  Self.VisibleScripts := [];

  logoSize := TControl.AdjustToDPI(125);
  logo.Create(panel);
  logo.setName('bash_logo');
  logo.SetLeft(TControl.AdjustToDPI(16));
  logo.SetTop(TControl.AdjustToDPI(10));
  logo.setWidth(logoSize);
  logo.setHeight(logoSize);
  logo.SetStretch(True);
  logo.SetProportional(True);
  logo.setHint('Open the B.A.S.H Discord');
  logo.setShowHint(True);
  logo.setOnClick(@Self._OnBrandingClick);


  logoPath := BashLogoPath();
  if FileExists(logoPath) then
  begin
    try
      logo.getPicture().LoadFromFile(logoPath);
    except

    end;
  end;

  textLeft := logo.getLeft() + logo.getWidth() + TControl.AdjustToDPI(14);

  branding.Create(panel);
  branding.setName('branding_label');
  branding.setCaption('B.A.S.H');
  branding.setLeft(textLeft);
  branding.SetTop(logo.GetTop() + TControl.AdjustToDPI(4));
  branding.SetFontSize(22);
  branding.SetFontColor($D4A017);
  with branding.getFont() do
    setStyle([TFontStyle.fsBold]);
  branding.setHint('Open the B.A.S.H Discord');
  branding.setShowHint(True);
  branding.setOnClick(@Self._OnBrandingClick);

  subtitle.Create(panel);
  subtitle.setName('subtitle_label');
  subtitle.setCaption('BigAussie Script House');
  subtitle.setLeft(textLeft);
  subtitle.SetTop(branding.GetTop() + branding.GetTrueHeight() + TControl.AdjustToDPI(2));
  subtitle.SetFontSize(11);
  subtitle.SetFontColor($A89F90);

  accentBar.Create(panel);
  accentBar.setName('accent_bar');
  accentBar.setCaption('');
  accentBar.setBevelWidth(0);
  accentBar.setColor($D4A017);
  accentBar.setLeft(textLeft);
  accentBar.SetTop(subtitle.GetTop() + subtitle.GetTrueHeight() + TControl.AdjustToDPI(6));
  accentBar.setWidth(Max(branding.GetTrueWidth(), subtitle.GetTrueWidth()));
  accentBar.setHeight(TControl.AdjustToDPI(3));

  discordLink.Create(panel);
  discordLink.setName('discord_label');
  discordLink.setCaption('discord.gg/qsmKs5uKfR');
  discordLink.setLeft(textLeft);
  discordLink.SetTop(accentBar.GetTop() + accentBar.getHeight() + TControl.AdjustToDPI(6));
  discordLink.SetFontSize(9);
  discordLink.SetFontColor($A89F90);
  discordLink.setHint('Click to join the B.A.S.H Discord.');
  discordLink.setShowHint(True);
  discordLink.setCursor(crHandPoint);
  discordLink.setOnClick(@Self._OnBrandingClick);

  sourcePanel.Create(panel);
  sourcePanel.setName('script_source_panel');
  sourcePanel.setCaption('');
  sourcePanel.setBevelWidth(0);
  sourcePanel.setColor($1A1814);
  sourcePanel.SetLeft(textLeft);
  sourcePanel.SetTop(discordLink.GetTop() + discordLink.getHeight() + TControl.AdjustToDPI(8));
  sourcePanel.setWidth(TControl.AdjustToDPI(420));
  sourcePanel.setHeight(TControl.AdjustToDPI(28));

  BashScriptClient.SetActiveSource(EScriptSource.BASH);

  radioTop := TControl.AdjustToDPI(4);

  bashRadio.Create(sourcePanel);
  bashRadio.setName('source_bash_radio');
  bashRadio.setCaption('');
  bashRadio.SetLeft(0);
  bashRadio.SetTop(radioTop);
  bashRadio.setWidth(TControl.AdjustToDPI(18));
  bashRadio.setOnClick(@Self._OnSourceChange);
  bashRadio.SetChecked(True);

  bashLabel.Create(sourcePanel);
  bashLabel.setName('source_bash_label');
  bashLabel.setCaption('B.A.S.H Scripts');
  bashLabel.SetLeft(bashRadio.GetLeft() + bashRadio.getWidth() + TControl.AdjustToDPI(4));
  bashLabel.SetTop(radioTop);
  bashLabel.SetFontColor($FFFFFF);
  bashLabel.setOnClick(@Self._OnSourceChange);

  localRadio.Create(sourcePanel);
  localRadio.setName('source_local_radio');
  localRadio.setCaption('');
  localRadio.SetLeft(TControl.AdjustToDPI(145));
  localRadio.SetTop(radioTop);
  localRadio.setWidth(TControl.AdjustToDPI(18));
  localRadio.setOnClick(@Self._OnSourceChange);
  localRadio.SetChecked(False);

  localLabel.Create(sourcePanel);
  localLabel.setName('source_local_label');
  localLabel.setCaption('Local Scripts');
  localLabel.SetLeft(localRadio.GetLeft() + localRadio.getWidth() + TControl.AdjustToDPI(4));
  localLabel.SetTop(radioTop);
  localLabel.SetFontColor($FFFFFF);
