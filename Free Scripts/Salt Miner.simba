  SM_GUI_NAV       = $F0EBE4;
  SM_GUI_BG        = $FFFFFF;
  SM_GUI_STATUS    = $F7F4F1;
  SM_GUI_DIVIDER   = $D4C9BC;
  SM_GUI_CARD      = $F7F4F1;
  SM_GUI_ACCENT    = $E0C9AE;
  SM_GUI_NAV_IDLE  = $E7DED4;
  SM_GUI_START     = $C9B094;
  SM_GUI_TEXT      = $1C1C1E;
  SM_GUI_MUTED     = $6B6B70;
  SM_GUI_W         = 1120;
  SM_GUI_H         = 700;
  SM_GUI_NAV_W     = 190;
  SM_GUI_STATUS_H  = 56;
  SM_GUI_BTN_H     = 42;
  SM_GUI_EDIT_W    = 260;
