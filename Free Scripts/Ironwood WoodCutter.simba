  Self.WebHookInput.SetVisible(ShowWebhook);
  Self.TestButton.SetVisible(ShowWebhook);
  Self.WebhookInfo.SetVisible(ShowWebhook);
  Self.HourlyReportsCheckBox.SetVisible(ShowWebhook);
  Self.SessionSummaryCheckBox.SetVisible(ShowWebhook);
end;

