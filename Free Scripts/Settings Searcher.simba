{$DEFINE SCRIPT_ID := 'bb216fcd-d3a6-4c47-9830-0b45ae3c91f8'}
{$DEFINE SCRIPT_REVISION := '3'}
program SettingsSearcher;
{$I BashLib/osr.simba}

{ Runs the BASHLib include setting handler standalone for setups that are experiencing issues}

procedure TRemoteInput.Free(); override;
begin
  Self.GetImage().DrawClear(0);
  Self.EnableRealInput();
end;

begin
  ClearDebug();
  BashPromptIfUpdateAvailable();
  SettingsHandler.RunDiagnostic();
end.
