{$UNDEF SCRIPT_ID}{$DEFINE SCRIPT_ID := 'cba5ca58-c6d2-48bc-b625-f54e300b4760'}
{$UNDEF SCRIPT_REVISION}{$DEFINE SCRIPT_REVISION := '1'}
{$DEFINE BASH_FARM_WITH_BIRDHOUSE}
{$IFDEF WINDOWS}{$DEFINE SCRIPT_GUI}{$ENDIF}
{$I SRL-B/osr.simba}
{$I BashLib/osr.simba}
{$I BashLib/optional/handlers/bashbirdhouse/bashbirdhouserunner.simba}
{$I BashLib/optional/handlers/bashfarm/bashfarmrunner.simba}

