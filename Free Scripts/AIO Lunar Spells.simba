  LS_GUI_START     = $C9B094;
  LS_GUI_TEXT      = $1C1C1E;
  LS_GUI_MUTED     = $6B6B70;
  LS_GUI_LINK      = $C07020;
  LS_GUI_W         = 1120;
  LS_GUI_H         = 780;
  LS_GUI_NAV_W     = 190;
  LS_GUI_STATUS_H  = 56;
  LS_GUI_BTN_H     = 42;
  LS_GUI_EDIT_W    = 260;
  LS_GUI_COMBO_W   = 260;
  LS_GUI_COMBO_H   = 58;
  LS_GUI_COMBO_FONT = 10;
  LS_GUI_COL2      = 308;
  LS_GUI_BOTTOM_INSET = 34;

type
  TConfig = record(TScriptForm)
    NavPanel, ContentPanel, StatusPanel, DividerPanel, StatusDivider, StatusPad: TPanel;
    BrandLabel: TLabel;
    ScriptNav, AccountsNav, AntibanNav, BirdhouseNav: TImage;
