  BA_SETTINGS_FILE = 'Configs/BASettings.ini';
  BA_AGILITY_SETTINGS = ' Free Agility Settings';
  BA_AGILITY_ANTIBAN = ' Free Agility Antiban Manager';

  AGILITY_PLUGIN_MIN_PIXELS = 20;
  AGILITY_MARK_MIN_PIXELS = 15;
  AGILITY_OVERLAY_EXPAND = 20;
  AGILITY_OVERLAY_HEIGHT = 7;
  AGILITY_CLICK_RETRIES = 3;
  AGILITY_BANK_LOCAL_RADIUS = 400;
  AGILITY_BANK_LOCAL_KEEP = 2;
  AGILITY_XP_GRACE_MS = 800;
  AGILITY_XP_MAX_DELTA = 3000;
  AGILITY_WALK_PX = 68;
  AGILITY_WALK_STOP_PX = 48;
  AGILITY_CLICK_SETTLE_MS = 400;
  AGILITY_ON_OBSTACLE_PX = 12;
  AGILITY_STANDING_PX = 24;
  AGILITY_MARKS_PER_AMYLASE_PACK = 10;
